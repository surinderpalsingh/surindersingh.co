---
interface Props {
  href: string;
  label: string;
  direction?: 'left' | 'up';
}

const { href, label, direction = 'left' } = Astro.props;
---
<nav class="meta">
  <a class="plain" href={href}>
    <span class="back-stack">
      {direction === 'up' ? (
        <svg class="back-icon back-icon-up" viewBox="0 0 57 57" aria-hidden="true">
          <path d="M0.0356445 42.8086C0.0356445 43.72 0.336737 44.4769 0.938924 45.0791C1.54119 45.6813 2.26549 45.9824 3.11182 45.9824C3.92562 45.9824 4.62549 45.6731 5.21142 45.0547C5.79736 44.4362 6.09032 43.7363 6.09032 42.9551V26.5977L5.55322 9.80078L11.7055 16.7344L51.0122 55.9922C51.6307 56.6107 52.3306 56.9199 53.1118 56.9199C53.9256 56.9199 54.6499 56.6025 55.2846 55.9677C55.9194 55.333 56.2368 54.5924 56.2368 53.7461C56.2368 52.9648 55.9276 52.2812 55.3091 51.6953L16.0512 12.3887L9.16652 6.23628L27.2817 6.72458H42.272C43.0858 6.72458 43.7938 6.43974 44.396 5.87008C44.9982 5.30041 45.2993 4.60868 45.2993 3.79488C45.2993 2.98108 45.0064 2.27308 44.4204 1.67088C43.8345 1.06868 43.0858 0.767578 42.1743 0.767578H3.30712C2.33059 0.767578 1.54936 1.06868 0.963425 1.67088C0.377458 2.27308 0.0844746 3.04618 0.0844746 3.99018L0.0356445 42.8086Z" />
        </svg>
      ) : (
        <svg class="back-icon back-icon-left" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.088 14.434c0-1.113-.24-2.093-.721-2.937-.481-.845-1.174-1.505-2.08-1.98-.904-.475-1.993-.713-3.265-.713H8.723l-2.83.123.267.485 2.095-1.77 2.159-2.111a.847.847 0 0 0 .27-.64.877.877 0 0 0-.246-.64c-.164-.167-.38-.251-.652-.251a.915.915 0 0 0-.667.286L4.292 9.039a.898.898 0 0 0-.292.68c0 .269.097.498.292.688l4.828 4.75c.19.19.413.285.667.285.271 0 .488-.084.652-.251a.885.885 0 0 0 .245-.645.863.863 0 0 0-.072-.36.85.85 0 0 0-.197-.274l-2.16-2.108-2.094-1.772-.266.487 2.83.12h5.35c.905 0 1.668.159 2.29.475.621.316 1.094.754 1.419 1.314.324.56.486 1.207.486 1.94 0 .727-.162 1.378-.486 1.951a3.416 3.416 0 0 1-1.42 1.352c-.621.328-1.385.492-2.29.492h-1.957a.893.893 0 0 0-.67.268.896.896 0 0 0-.26.647.904.904 0 0 0 .931.922h2.014c1.253 0 2.323-.23 3.211-.691.888-.46 1.568-1.109 2.039-1.944.47-.835.706-1.812.706-2.93Z" />
        </svg>
      )}
      <span class="back-label"><em>{label}</em></span>
    </span>
  </a>
</nav>

<style>
  .meta a {
    display: inline;
    text-decoration: none;
  }

  .back-stack {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 192px;
    height: 28px;
    font: 400 16px/28px var(--sans);
  }

  .back-icon {
    display: block;
    flex: 0 0 auto;
    color: #ededed;
    fill: currentColor;
    transform: none;
  }

  .back-icon-up {
    width: 12px;
    height: 12px;
  }

  .back-icon-left {
    width: 14px;
    height: 14px;
  }

  .back-label {
    display: block;
    height: 28px;
    line-height: 28px;
  }

  .back-label em {
    font: 400 italic 17px/normal var(--serif);
  }
</style>
